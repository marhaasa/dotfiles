{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/github.com/marhaasa/dotfiles/scripts/claude-nvim-status",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
