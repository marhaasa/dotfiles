# theme = gruvbox-material
theme = Gruvbox Dark Hard
# theme = Catppuccin Mocha

font-size = 20
# font-family = "UbuntuMono Nerd Font"
# font-family = "Mononoki"
font-family = "IosevkaTerm Nerd Font"
font-thicken = true

window-save-state = always

command = /opt/homebrew/bin/zsh

shell-integration = zsh

macos-titlebar-style = tabs

# custom-shader = /Users/mariushogliaasarod/Repos/github.com/m-ahdal/ghostty-shaders/just-snow.glsl
# custom-shader = /Users/mariushogliaasarod/Repos/github.com/m-ahdal/ghostty-shaders/glitchy.glsl

keybind = ctrl+b=new_split:auto
keybind = shift+ctrl+b=close_surface
keybind = shift+enter=text:\n

# Notify when a command that ran for 30s+ finishes while Ghostty is unfocused (Ghostty 1.3+).
# Useful for buildsql / sqlchanges. Requires shell-integration (zsh) for OSC 133 markers.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 30s
