function icloud_backup_photos() {

  local args=(
    -r              # Recursive
    --times         # Preserve modification times (important for change detection)
    --no-perms      # Skip permissions (good for most external drives)
    --human-readable
    --partial
    --progress
    -v
)

    local USER="$(whoami)"
    local src="/Users/$USER/Pictures/Photos Library.photoslibrary/originals/"
    local dest="$1"

    if [[ -z "$dest" ]]; then
        echo "❌  Error: No destination folder provided."
        echo "Usage: backup_icloud_photos /path/to/destination"
        return 1
    fi

    echo "⏩  Source: $src"
    echo "⏩  Destination: $dest"
    echo "⏩  Starting rsync backup..."
    echo ""

    rsync "${args[@]}" "$src" "$dest"

    echo ""
    echo "🌈  Done!"
    echo ""
}

