clone() {
  local repo="$1" user name userd path
  repo="${repo#https://github.com/}"
  repo="${repo#git@github.com:}"
  if [[ $repo == */* ]]; then
    user="${repo%%/*}"
  else
    user="$GITUSER"
    [[ -z "$user" ]] && user="$USER"
  fi
  name="${repo##*/}"
  userd="$REPOS/github.com/$user"
  path="$userd/$name"

  [[ ! -d "$REPOS/github.com" ]] && mkdir -p "$REPOS/github.com"
  [[ ! -d "$userd" ]] && mkdir -p "$userd"
  
  if [[ -d "$path" ]]; then
    cd "$path" && return
  fi
  
  cd "$userd"
  gh repo clone "$user/$name" -- --recurse-submodule
  cd "$name"
}
