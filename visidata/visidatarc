@Sheet.api
def view_cell_full(sheet):
    '''Push a TextSheet with the full contents of the current cell,
    pretty-printed when the value is a JSON object or array.'''
    text = sheet.cursorFullDisplay
    try:
        parsed = json.loads(text)
        if isinstance(parsed, (dict, list)):
            text = json.dumps(parsed, indent=2, ensure_ascii=False)
    except Exception:
        pass
    name = '_'.join([sheet.name, sheet.cursorCol.name or 'cell'])
    vd.push(TextSheet(name, source=text.splitlines() or ['']))


Sheet.addCommand('V', 'view-cell-full', 'sheet.view_cell_full()',
                 'view full contents of current cell (pretty-prints JSON)')
